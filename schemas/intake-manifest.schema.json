{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper library intake manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "topic": { "$ref": "#/$defs/topic" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/localItem" },
          { "$ref": "#/$defs/pendingItem" },
          { "$ref": "#/$defs/attachmentItem" }
        ]
      }
    }
  },
  "$defs": {
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "headings"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*(/[A-Z][A-Za-z0-9]*)*$"
        },
        "headings": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "citationKey": {
      "type": "string",
      "pattern": "^[a-z]+[0-9]{4}[a-z0-9]+$"
    },
    "distinctFrom": {
      "description": "Citation keys of verified distinct works that share this record's normalized title (and, for albums and films, release year and first creator).",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/citationKey" }
    },
    "canonicalFilename": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*\\.(pdf|epub|mobi)$"
    },
    "sidecars": {
      "type": "array",
      "items": { "type": "string", "pattern": "\\.(bib|bibtex)$" },
      "uniqueItems": true
    },
    "metadataSources": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "uniqueItems": true
    },
    "fields": {
      "type": "object",
      "minProperties": 2,
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "editor": { "type": "string", "minLength": 1 },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "year": { "type": "string", "pattern": "^[0-9]{4}$" },
        "doi": { "type": "string", "minLength": 1 },
        "isbn": {
          "type": "string",
          "pattern": "^(ISBN(-1[03])?:?[ ]*)?[0-9Xx \\u2010\\u2011\\u2012\\u2013\\u2014-]+$"
        },
        "url": { "type": "string", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s]+$" },
        "imdb": {
          "type": "string",
          "pattern": "^(https?://((www|m)\\.)?imdb\\.com/title/)?[Tt]{2}[0-9]{7,10}/?$"
        },
        "musicbrainz": {
          "type": "string",
          "pattern": "^(https?://(beta\\.)?musicbrainz\\.org/(release-group|recording)/)?[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}/?$"
        },
        "wikidata": {
          "type": "string",
          "pattern": "^(https?://((www|m)\\.)?wikidata\\.org/(wiki|entity)/)?[Qq][1-9][0-9]*/?$"
        }
      },
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
        "not": { "enum": ["title", "keywords", "file", "distinctfrom"] }
      },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "number" }
        ]
      },
      "allOf": [
        {
          "anyOf": [
            { "required": ["author"] },
            { "required": ["editor"] }
          ]
        },
        {
          "anyOf": [
            { "required": ["date"] },
            { "required": ["year"] }
          ]
        }
      ]
    },
    "localItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "canonical_filename",
        "citation_key",
        "title",
        "fields"
      ],
      "properties": {
        "attach": { "const": false },
        "pending": { "const": false },
        "source_file": { "type": "string", "minLength": 1 },
        "canonical_filename": { "$ref": "#/$defs/canonicalFilename" },
        "citation_key": { "$ref": "#/$defs/citationKey" },
        "entry_type": { "type": "string", "pattern": "^[A-Za-z]+$" },
        "title": { "type": "string", "minLength": 1 },
        "bib_title": { "type": "string", "minLength": 1 },
        "fields": { "$ref": "#/$defs/fields" },
        "distinct_from": { "$ref": "#/$defs/distinctFrom" },
        "metadata_sources": { "$ref": "#/$defs/metadataSources" },
        "sidecars": { "$ref": "#/$defs/sidecars" }
      }
    },
    "pendingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "citation_key", "title", "fields"],
      "properties": {
        "attach": { "const": false },
        "pending": { "const": true },
        "citation_key": { "$ref": "#/$defs/citationKey" },
        "entry_type": { "type": "string", "pattern": "^[A-Za-z]+$" },
        "title": { "type": "string", "minLength": 1 },
        "bib_title": { "type": "string", "minLength": 1 },
        "fields": { "$ref": "#/$defs/fields" },
        "distinct_from": { "$ref": "#/$defs/distinctFrom" },
        "metadata_sources": { "$ref": "#/$defs/metadataSources" },
        "sidecars": { "$ref": "#/$defs/sidecars" }
      }
    },
    "attachmentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attach",
        "citation_key",
        "source_file",
        "canonical_filename"
      ],
      "properties": {
        "attach": { "const": true },
        "citation_key": { "$ref": "#/$defs/citationKey" },
        "source_file": { "type": "string", "minLength": 1 },
        "canonical_filename": { "$ref": "#/$defs/canonicalFilename" },
        "metadata_sources": { "$ref": "#/$defs/metadataSources" },
        "sidecars": { "$ref": "#/$defs/sidecars" }
      }
    }
  }
}
